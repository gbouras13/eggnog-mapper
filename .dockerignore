# Keep the build context small and the image reproducible.
# container/hpci/Dockerfile does `COPY . /opt/eggnog-mapper`, so anything
# left here is baked into the image.

.git
.github
**/__pycache__/
**/*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Local scratch / downloaded data — never belongs in an image.
eggnongdb/
data/eggnog.db
data/*.dmnd
data/mmseqs/
data/pfam/
data/foldseek/
**/models--*/

# Local-only notes.
PHOENIX-SETUP.md
